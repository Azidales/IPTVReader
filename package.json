{
  "name": "iptvreader",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "build:desktop": "tsc --noEmit && vite build --config vite.desktop.config.ts",
    "desktop:dev": "npm run build:desktop && electron .",
    "test:desktop": "node --test desktop/*.test.cjs"
  },
  "dependencies": {
    "dashjs": "^5.1.0",
    "hls.js": "^1.6.0",
    "mpegts.js": "^1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.cjs"
}
